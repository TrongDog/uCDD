#!/usr/bin/env python3
"""commit-msg: nothing personal goes to GitHub (lib/privacy.py; the owner, 10 Nov 2026; tightening
r3.10). Reads the message, the identity and the lines the commit adds,
against the [[banned]] list (method.toml and method.local.toml)."""

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / 'lib'))
import docs  # noqa: E402
import privacy  # noqa: E402

code = privacy.main(['commit-msg', '--scope', 'fork', *sys.argv[1:]])
# The pages keep up (lib/docs.py, r3.11): on the pages' branch, when the commit stages a page.
problems = docs.staged_problems()
if problems:
    print('commit-msg: refused', file=sys.stderr)
    for problem in problems:
        print(f'  - {problem}', file=sys.stderr)
sys.exit(code or (1 if problems else 0))
