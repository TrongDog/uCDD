#!/usr/bin/env python3
"""The bench repository's pre-commit check: no commit while a plan records, no game, program,
disc or big file, no absolute home path in any file, and in the top folder's notes no time
heading the clock tool did not write.

The bench is private, but we never ship game code anywhere, and a backup is
only useful if it can be cloned onto a new machine in minutes. Built
binaries (UCDD.EXE, the test .COM programs, the kits) come back from their
sources and are not kept. Exceptions go in .bench-allow at the top of the
bench repository: one shell glob a line, # comments allowed.

A moved file is read as a new one (the owner's decision of 6 Nov 2026: "the bench pre-commit lists
staged files with renames off (--no-renames) so a moved file is read"); tests/test_moves.py.

The size check skips the ledger's runs file, found by its path and by nothing else (the owner's
decision of 6 Nov 2026 on question 67 (7): "the bench size check excludes the ledger's runs file
by path, and from A7 the ledger rolls the file per gate"): methodlib's ledger folder and the name
methodlib.append writes, resolved, as a path inside the repository being committed (the top
folder, where ledger.py commit-runs commits it; in the bench repository it lies outside, so
nothing is skipped there). Another file of the same name elsewhere, or any other file over the
limit, is refused as before; every other check still reads the runs file. Until A7 rolls it, the
file grows past 20 MB in the top folder only. Built, not run (6 Nov 2026): tests/test_runs_size.py.
The lessons for this change: lessons_read = "terms: ledger, size, hook, commit; lessons: L38,
L20, L40, L33, L41, L10, L22, L39, L32; 6 Nov 2026"; the line below is the renames change's.

The clock check (the owner's decision of 6 Nov 2026, lesson L40: "every time heading in HANDOFF and
STATE is written by a tool from the clock, and the commit check refuses a time line the tool did
not write"): when a commit adds or changes context/HANDOFF.md or context/STATE.md (the top
folder's notes; the bench repository holds neither, so nothing changes there), this hook runs the
repository's own context/clockhead.py check on those files, and each line it prints is a
refusal. What it reads (its docstring has the line forms and why): every new '## ' entry
heading of HANDOFF (its stamp, and a clock time typed in its title), and the new time ranges that
open STATE's dated results and gap paragraphs, outside quotes and backquotes, each against the
record of what clockhead.py issued. A clocked file staged with no context/clockhead.py
in the repository is refused (a check that went missing never passes a commit). Not on the
hourly backup's snapshot (bench/backup.sh runs this hook on an index of its own): the check is
for commits, and a typed heading in the working tree must never cost a backup; the commit is
still refused. Told apart by fact, both together: the hook is not run by git (its parent process
is not git; a commit's hook always is) and its index (GIT_INDEX_FILE) lies outside the
repository's git folder (backup.sh's lies in a temporary folder; a commit's is the git folder's
index, its lock, or a next-index file there). That a commit cannot reach the skip rests on git
being its hook's parent even when GIT_INDEX_FILE names another index (silent: githooks(5)):
UNMEASURED until tests/test_clock_hook.py's cases 8 and 9 run on this host's git. Built, not run
(6 Nov 2026): tests/test_clock_hook.py (the wiring, with a stand-in tool) and the top folder's
context/test_clockhead.py (the tool, and the two typed headings of 6 Nov through this hook).
lessons_read = "terms: clock, heading, time, hook, commit, backup; lessons: L38, L40, L20, L33, L10, L18, L22, L16, L32, L43; 6 Nov 2026"

lessons_read = "terms: rename, hook, commit, check, staged, backup; lessons: L11, L4, L38, L2, L30, L7, L35, L20, L40, L33, L13, L19, L37, L41, L10, L15, L22, L12, L25, L31, L32, L42, L43, L21, L26, L36, L23; 6 Nov 2026"
"""

from pathlib import Path
import fnmatch
import os
import re
import subprocess
import sys
import tomllib

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / 'lib'))
import methodlib  # noqa: E402
import privacy  # noqa: E402

BENCH = tomllib.loads((Path(__file__).resolve().parent.parent / 'bench.toml').read_text())
REFUSED = set(methodlib.CONFIG['games']['suffixes']) | set(BENCH['refuse'])
LOCAL_PATH = re.compile(next(entry['pattern'] for entry in methodlib.CONFIG['banned']
                             if 'local path' in entry['why']))
# runs/recording.flag (the owner, 4 Nov 2026, from rules-bot, lesson L6: "the bench's pre-commit
# refuses any commit while the recording flag is set, the same flag the backup honours; a commit
# that must wait, waits"). The flag is the bench's, found from this hook's own place
# (<bench>/runs/src/method/bench/hooks), so the top folder, which uses this hook too, waits as
# well. As runs/quiet.sh reads it for the backups: the recorder's PID first, and a flag whose PID
# is gone is stale and ignored. UCDD_RECORDING_FLAG names another flag (the tests).
RECORDING_FLAG = Path(os.environ.get('UCDD_RECORDING_FLAG') or
                      Path(__file__).resolve().parents[4] / 'recording.flag')


def git(*args):
    return subprocess.run(['git', *args], capture_output=True, check=True).stdout


def recording():
    """The flag's first line while the PID it names is alive, else None."""
    try:
        line = RECORDING_FLAG.read_text().splitlines()[0]
        pid = int(line.split()[0])
    except (OSError, IndexError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return None
    except PermissionError:
        pass
    return line


# The notes whose time headings the top folder's clock check reads, and its tool, as paths in the
# repository being committed (the owner's decision of 6 Nov 2026, lesson L40)
CLOCKED = ('context/HANDOFF.md', 'context/STATE.md')
CLOCK_TOOL = 'context/clockhead.py'


def run_by_git():
    """Whether git runs this hook (its parent process is git), as for every commit; a parent that
    cannot be read counts as git, so the clock check is never skipped by a failed reading."""
    try:
        return Path(f'/proc/{os.getppid()}/comm').read_text().strip() == 'git'
    except OSError:
        return True


def own_index():
    """Whether the index this hook reads is the repository's own: GIT_INDEX_FILE unset, or a file
    inside the git folder (the index, its lock, a next-index file); backup.sh's snapshot index,
    in a temporary folder, is not."""
    index = os.environ.get('GIT_INDEX_FILE')
    if not index:
        return True
    git_dir = Path(git('rev-parse', '--absolute-git-dir').decode().strip()).resolve()
    path = Path(index) if Path(index).is_absolute() else Path.cwd() / index
    try:
        path.resolve().relative_to(git_dir)
    except ValueError:
        return False
    return True


def clock_problems(top, names):
    """The clock check's refusals for the clocked notes among NAMES (staged, added or changed),
    from TOP's own context/clockhead.py check: one line each, as it prints them. None staged, or
    the backup's snapshot (not run by git, on an index of its own): nothing to check."""
    staged = [name for name in CLOCKED if name in names]
    if not staged or (not run_by_git() and not own_index()):
        return []
    tool = top / CLOCK_TOOL
    if not tool.is_file():
        return [f'{name}: its time headings are checked by {CLOCK_TOOL}, which this repository does '
                'not hold (L40): restore it before committing the notes' for name in staged]
    done = subprocess.run([sys.executable, str(tool), 'check', *staged], cwd=top,
                          capture_output=True, text=True, errors='replace')
    if done.returncode == 0:
        return []
    said = [line.strip() for line in done.stdout.splitlines() if line.strip()]
    if said:
        return said
    err = ' | '.join(line.strip() for line in done.stderr.splitlines() if line.strip()) or 'no message'
    return [f'{CLOCK_TOOL} check: exit {done.returncode}: {err[-400:]}']


def runs_file_in(top):
    """The ledger's runs file as a path in the repository at TOP, in git's form, or None when it
    lies outside it (the bench repository). Its path is methodlib's: the ledger folder
    (methodlib.ledger_dir, UCDD_LEDGER or method.toml's [ledger] path) and the name methodlib.append
    and ledger.py commit-runs write, resolved as commit-runs resolves it."""
    try:
        return (methodlib.ledger_dir() / 'runs.jsonl').resolve().relative_to(top.resolve()).as_posix()
    except ValueError:
        return None


def main():
    held = recording()
    if held:
        print(f'pre-commit: refused: a plan is recording ({RECORDING_FLAG}: {held}); nothing is '
              'committed while it records (L6): commit once the flag clears', file=sys.stderr)
        return 1
    top = Path(git('rev-parse', '--show-toplevel').decode().strip())
    allow_file = top / '.bench-allow'
    allowed = [line.split('#')[0].strip() for line in allow_file.read_text().splitlines()] \
        if allow_file.exists() else []
    allowed = [pattern for pattern in allowed if pattern]
    # Renames off (the owner's decision of 6 Nov 2026). git diff detects renames by default
    # (diff.renames), and a moved file is then one R entry, old path to new, which the A and M
    # filter drops: a file moved with git mv, or moved and edited, was never read here, under its
    # new name or any other. With --no-renames it is a D of the old path, which needs no check,
    # and an A of the new one, read whole like any other added file. Copies (diff.renames=copies)
    # are split the same way.
    names = [name for name in git('diff', '--cached', '--no-renames', '--name-only',
                                  '--diff-filter=AM', '-z')
             .decode('utf-8', 'replace').split('\0') if name]
    # the home-path check is for what goes to GitHub: a repository with no remote (the top folder,
    # which holds the ledger and the notes with their paths, and never gets one) is not checked for it
    pushed = bool(git('remote').strip())
    runs_name = runs_file_in(top)
    # the time headings of the top folder's notes (L40), whatever .bench-allow says
    clock = clock_problems(top, names)
    problems = []
    for name in names:
        if any(fnmatch.fnmatchcase(name, pattern) for pattern in allowed):
            continue
        if Path(name).suffix.lower() in REFUSED:
            problems.append(f'{name}: a game, program, disc, recording or image file; keep it on the '
                            'bench, backed up apart (or rebuild it from its source)')
            continue
        size = int(git('cat-file', '-s', f':{name}').decode().strip())
        # the ledger's runs file by its path alone (decision 67 (7)): the size check only
        if size > BENCH['max_mb'] * 1024 * 1024 and name != runs_name:
            problems.append(f'{name}: {size // (1024 * 1024)} MB, over {BENCH["max_mb"]} MB')
            continue
        # no absolute home path in any file (the owner, 2 Nov 2026: 839 records had carried one);
        # the pattern is the fork's own, method.toml's [[banned]] local path
        text = git('show', f':{name}') if pushed else b'\0'
        if b'\0' not in text:
            for number, line in enumerate(text.decode('utf-8', 'replace').splitlines(), 1):
                if LOCAL_PATH.search(line):
                    problems.append(f'{name}:{number}: a local path; write it as ~/ or relative to the bench')
                    break
    # nothing personal goes to GitHub (the owner, 10 Nov 2026; tightening r3.10): the personal
    # entries of [[banned]] (method.local.toml's) against the identity and the lines this commit,
    # or the hourly snapshot, adds over HEAD, with renames on (lib/privacy.py says why); only
    # for a repository with a remote, and whatever .bench-allow says
    personal = privacy.staged_problems('bench') if pushed else []
    if not problems and not clock and not personal:
        return 0
    if problems:
        print('pre-commit: refused (bench/bench.toml in the method package)', file=sys.stderr)
        for problem in problems:
            print(f'  - {problem}', file=sys.stderr)
        print('An exception goes in .bench-allow with a comment saying why.', file=sys.stderr)
    if clock:
        print(f'pre-commit: refused: a time line the clock tool did not write (L40; {CLOCK_TOOL})',
              file=sys.stderr)
        for problem in clock:
            print(f'  - {problem}', file=sys.stderr)
        print(f'Write each with python3 {CLOCK_TOOL} (handoff for a HANDOFF heading, range for '
              'STATE), never by hand; .bench-allow does not except them.', file=sys.stderr)
    if personal:
        privacy.report('pre-commit', personal)
    return 1


if __name__ == '__main__':
    sys.exit(main())
